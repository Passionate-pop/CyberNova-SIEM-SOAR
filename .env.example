# ═════════════════════════════════════════════════════════════════════════════
# CyberNova — Environment Configuration Example
# ═════════════════════════════════════════════════════════════════════════════
# Copy to .env and fill in REAL random values:
#   cp .env.example .env
#
# Generate secrets with:  openssl rand -hex 32   (run 3 times for 3 secrets)
# ═════════════════════════════════════════════════════════════════════════════

# ── Core secrets (REQUIRED — 64+ char random strings) ───────────────────────
JWT_SECRET=change-me-64-char-random-string-change-me-64-char-random
SECRET_KEY=change-me-64-char-random-string-change-me-64-char-random
ADMIN_PASSWORD=ChangeMe_Admin_123
AGENT_PASSWORD=ChangeMe_Agent_123
POSTGRES_PASSWORD=ChangeMe_Postgres_123
REDIS_PASSWORD=ChangeMe_Redis_123
GRAFANA_PASSWORD=ChangeMe_Grafana_123

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your domain / localhost)
CORS_ORIGINS=https://localhost,http://localhost:8080

# ── Optional: SMTP email (leave blank to disable email notifications) ───────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=admin@cybernova.local

# ── Optional: Threat Intelligence API keys ───────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ── Optional: Tuning ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
UVICORN_WORKERS=1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
