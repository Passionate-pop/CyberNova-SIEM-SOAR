# ═════════════════════════════════════════════════════════════════════════════
# CyberNova — Production Environment Configuration
# ═════════════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in ALL values before deployment.
#   cp .env.production.example .env
#   docker compose --profile production up -d
# ═════════════════════════════════════════════════════════════════════════════

# ── REQUIRED: Security (MUST change from defaults) ─────────────────────────
# Generate keys: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generate-a-64-char-random-hex-string>
SECRET_KEY=<generate-a-different-64-char-random-hex-string>

# Admin account - first-run setup creates admin with this password
ADMIN_PASSWORD=<strong-admin-password-min-12-chars>
AGENT_PASSWORD=<agent-auth-password-min-12-chars>

# ── REQUIRED: Database ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=<generate-a-strong-random-password>

# ── REQUIRED: Redis ────────────────────────────────────────────────────────
REDIS_PASSWORD=<generate-a-strong-random-password>

# ── REQUIRED: Domain & CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# For single domain: https://cybernova.yourcompany.com
# For multiple: https://app.cybernova.com,https://admin.cybernova.com
CORS_ORIGINS=https://your-domain.com

# ── OPTIONAL: External Integrations ───────────────────────────────────────
# Threat Intelligence APIs (recommended for production)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# SMTP / Email (for alert notifications)
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=cybernova@your-email-provider.com
SMTP_PASSWORD=
FROM_EMAIL=cybernova@your-domain.com
FROM_NAME=CyberNova Security

# On-Call / Alerting
ONCALL_EMAIL=oncall@your-domain.com
ALERT_EMAIL_TO=security-team@your-domain.com

# ── OPTIONAL: External Service Integrations ────────────────────────────────
# Slack
INTEGRATIONS_SLACK_WEBHOOK=
INTEGRATIONS_SLACK_TOKEN=

# Microsoft Teams
INTEGRATIONS_TEAMS_WEBHOOK=

# PagerDuty (for P1 incident paging)
INTEGRATIONS_PAGERDUTY_KEY=

# Opsgenie (for P1 incident paging)
CYBERNOVA_OPSGENIE_KEY=

# Jira (for automated ticket creation)
INTEGRATIONS_JIRA_URL=
INTEGRATIONS_JIRA_EMAIL=
INTEGRATIONS_JIRA_TOKEN=
INTEGRATIONS_JIRA_PROJECT=SEC

# ServiceNow
INTEGRATIONS_SERVICENOW_URL=
INTEGRATIONS_SERVICENOW_USERNAME=
INTEGRATIONS_SERVICENOW_PASSWORD=

# ── OPTIONAL: Grafana ──────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=<generate-a-strong-password>

# ── OPTIONAL: OpenTelemetry ────────────────────────────────────────────────
OTEL_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=cybernova

# ── OPTIONAL: Performance Tuning ───────────────────────────────────────────
# Expected events per second (for pool sizing)
DB_EXPECTED_EPS=10000
DB_POOL_SIZE=0
DB_MAX_OVERFLOW=0

# Redis max memory
REDIS_MAXMEMORY=512mb

# ── OPTIONAL: Feature Flags ────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
SOAR_ENABLED=true
SOAR_AUTO_APPROVE_TIMEOUT=15

# ── OPTIONAL: Suricata NIDS ────────────────────────────────────────────────
SURICATA_INTERFACE=eth0
SENSOR_HOSTNAME=suricata-sensor-1
